<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FileViewer.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="5" />
    </Style>
  </Application.Styles>
</Application>
